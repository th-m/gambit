      "priority": 1,
      "description": "Define core TypeScript types for game entities",
      "acceptance_criteria": [
        "Game type includes all fields from technical plan (id, game_key, host_id, status, phase, current_round, crown_index, rejection_count, good_victories, evil_victories, selected_team, winner, end_reason)",

        "GameAction type includes all fields for audit log",
        "GameModifier type for temporary effects on game state",
        "PlayerStatus type for temporary player statuses",
        "GamePhase enum with all phases (lobby, voting_for_leader, selecting_team, mission_voting, resolution, assassination)",
        "Types exported from app/types/game.ts"
